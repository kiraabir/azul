# AZUL Production Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env with real secrets

# ============================================
# SECURITY - REQUIRED
# ============================================

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# This must be at least 32 characters (256 bits)
SECRET_KEY=your-256-bit-secure-random-key-here-change-me

# Admin password for initial setup
ADMIN_PASSWORD=your-secure-admin-password-here

# ============================================
# DATABASE - REQUIRED
# ============================================

# Supabase PostgreSQL connection string
# Example: postgresql://user:password@host:port/database
# Obtain from Supabase project settings
DATABASE_URL=postgresql://username:password@host:port/database

# ============================================
# APPLICATION - REQUIRED FOR PRODUCTION
# ============================================

# Flask environment (must be 'production' for security features)
FLASK_ENV=production

# Debug mode (MUST be False in production)
DEBUG=False

# Timezone (Morocco uses WET/WEST)
TZ=Africa/Casablanca

# ============================================
# OPTIONAL - FEATURES
# ============================================

# Rate limiting (optional)
# RATELIMIT_ENABLED=True
# RATELIMIT_DEFAULT=200 per day;50 per hour

# Gunicorn workers (auto-detected by Render)
# GUNICORN_WORKERS=2

# ============================================
# OPTIONAL - INTEGRATIONS (ADD WHEN READY)
# ============================================

# SMS Gateway credentials (add when SMS is ready)
# TWILIO_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_PHONE=+212XXXXXXXX

# Google Wallet credentials
# GOOGLE_MERCHANT_ID=your-google-merchant-id
# GOOGLE_API_KEY=your-google-api-key

# Apple Wallet credentials (passkit)
# APPLE_PASS_TYPE_ID=pass.com.yourcompany.azul
# APPLE_TEAM_ID=your-app-team-id
# APPLE_KEY_ID=key-id
# APPLE_PRIVATE_KEY=base64-encoded-p12-key